@host = http://localhost:3000
@productsUrl = {{host}}/api/v1/products

### Comprobar que el servidor está disponible
GET {{host}}/health

### Consultar los productos activos antes de la prueba
GET {{productsUrl}}/getAll

### Crear el producto que se utilizará en el recorrido
# @name crearProducto
POST {{productsUrl}}/create
Content-Type: application/json

{
  "name": "Café de prueba",
  "price": 129.90,
  "stock": 20,
  "description": "Producto creado para comprobar el recorrido de la API",
  "brand": "Sierra Norte",
  "img": "https://example.com/cafe.jpg"
}

### Consultar el producto activo recién creado
GET {{productsUrl}}/getById/{{crearProducto.response.body.$.product.id}}

### Actualizar completamente el producto creado
PUT {{productsUrl}}/update/{{crearProducto.response.body.$.product.id}}
Content-Type: application/json

{
  "name": "Café tostado actualizado",
  "price": 139.50,
  "stock": 16,
  "description": "Producto actualizado mediante una solicitud PUT",
  "brand": "Sierra Norte",
  "img": "https://example.com/cafe-actualizado.jpg"
}

### Cambiar únicamente el precio del producto
PATCH {{productsUrl}}/change-price/{{crearProducto.response.body.$.product.id}}
Content-Type: application/json

{
  "price": 124.90
}

### Dar de baja lógicamente el producto
DELETE {{productsUrl}}/delete/{{crearProducto.response.body.$.product.id}}

### Confirmar que el producto dado de baja no aparece en el listado
GET {{productsUrl}}/getAll

### Confirmar que el producto dado de baja ya no puede consultarse por ID
GET {{productsUrl}}/getById/{{crearProducto.response.body.$.product.id}}

### Consultar un producto inexistente
GET {{productsUrl}}/getById/2147483647

### Consultar con un ID inválido
GET {{productsUrl}}/getById/abc

### Intentar crear un producto con precio inválido
POST {{productsUrl}}/create
Content-Type: application/json

{
  "name": "Producto con precio inválido",
  "price": -10,
  "stock": 5,
  "description": "Esta solicitud debe ser rechazada",
  "brand": null,
  "img": null
}

### Intentar crear un producto con un cuerpo incompleto
POST {{productsUrl}}/create
Content-Type: application/json

{
  "name": "Producto incompleto",
  "price": 25
}
